# Copy this file to .env.local and fill in your Supabase project values.
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Project Settings -> API -> service_role key. NEVER expose this to the browser
# or commit it. Only used by scripts/import-tasks.mjs to seed data.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only @ 뒤 도메인을 가진 이메일만 회원가입을 허용합니다.
ALLOWED_EMAIL_DOMAIN=wonandone.co.kr
